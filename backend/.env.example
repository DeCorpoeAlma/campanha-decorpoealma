# API Keys
# Obtenha sua chave em https://openrouter.ai/
OPENROUTER_API_KEY=sua_chave_api_aqui

# CORS
# Origens permitidas separadas por vírgula
ALLOWED_ORIGINS=https://decorpoealma.netlify.app,http://localhost:5173

# Redis (opcional, para persistência de sessões)
# Descomente e configure se estiver usando Redis
# REDIS_URL=redis://localhost:6379/0

# Armazenamento persistente (opcional)
# Caminho para armazenar dados persistentes como emails de inscrição
# PERSISTENT_DISK_PATH=/caminho/para/armazenamento/persistente

# Configurações do modelo
# Modelo padrão a ser usado quando não especificado
DEFAULT_MODEL=anthropic/claude-3.5-sonnet
# Limite máximo de tokens para respostas
MAX_TOKENS=1000
# Temperatura para geração (0.0-1.0, menor = mais determinístico)
TEMPERATURE=0.7